@page "/by-rack"
@inject InventoryManager Manager

<PageTitle>By Rack</PageTitle>

@if (!_loaded)
{
    <div class="loading-msg">Loading inventory...</div>
}
else
{
    <div class="page-header">
        <h1>BY RACK</h1>
    </div>

    @if (!Manager.RackSettings.HasRacks)
    {
        <p class="subtitle">You've told Settings you don't use racks, so no paint has a rack location. Turn "I have racks" back on in Settings if that changes.</p>
    }
    else
    {
        <div class="rack-tabs">
            @for (int r = 1; r <= _maxRack; r++)
            {
                int rack = r;
                <button class="tab @(_rack == rack ? "active" : "")" @onclick="() => _rack = rack">
                    Rack @rack
                </button>
            }
        </div>

        <div class="rack-legend">
            @foreach (var cat in OrderedCategories)
            {
                var p = new Paint { Category = cat };
                <span class="cat-badge" style="background:@p.CategoryCssColor; color:@p.CategoryTextColor">@cat</span>
            }
        </div>

        <div class="rack-grid">
            @{
                var grid = Manager.GetByRack(_rack).ToDictionary(p => (p.Row, p.Column));
            }
            <div class="rack-col-headers" style="grid-template-columns: 52px repeat(@Manager.RackSettings.ColumnsPerRack, minmax(110px, 1fr));">
                <div class="rack-row-label"></div>
                @for (int c = 1; c <= Manager.RackSettings.ColumnsPerRack; c++)
                {
                    <div class="rack-col-header">Col @c</div>
                }
            </div>
            @for (int row = 1; row <= Manager.RackSettings.RowsPerRack; row++)
            {
                int r2 = row;
                <div class="rack-row" style="grid-template-columns: 52px repeat(@Manager.RackSettings.ColumnsPerRack, minmax(110px, 1fr));">
                    <div class="rack-row-label">Row @row</div>
                    @for (int col = 1; col <= Manager.RackSettings.ColumnsPerRack; col++)
                    {
                        int c2 = col;
                        if (grid.TryGetValue((r2, c2), out var paint))
                        {
                            var usedIn = Guides.WhereUsed(paint.Name);
                            var tooltip = usedIn.Count > 0
                                ? $"{paint.DisplayName}\nUsed in:\n" + string.Join("\n", usedIn.Select(u => $"{Guides.GameLabel(u.Game)} — {u.FactionName} — {u.UnitName}"))
                                : paint.DisplayName;
                            <div class="rack-cell @(paint.IsOwned ? "cell-owned" : "cell-missing")"
                                 style="border-left: 4px solid @paint.CategoryCssColor"
                                 title="@tooltip"
                                 @onclick="() => ToggleOwned(paint)">
                                <span class="cell-check">@(paint.IsOwned ? "✓" : "○")</span>
                                <span class="cell-name">@paint.DisplayName</span>
                            </div>
                        }
                        else
                        {
                            <div class="rack-cell cell-empty">—</div>
                        }
                    }
                </div>
            }
        </div>
    }
}

@code {
    private bool _loaded;
    private int _rack = 1;
    private int _maxRack = 1;

    protected override async Task OnInitializedAsync()
    {
        await Manager.InitializeAsync();
        _maxRack = Manager.Paints.Count > 0 ? Manager.Paints.Max(p => p.RackNumber) : 1;
        _loaded = true;
    }

    private IEnumerable<PaintCategory> OrderedCategories =>
        Manager.CategorySettings
            .Where(s => s.Enabled)
            .OrderBy(s => s.SortOrder)
            .Select(s => s.Category);

    private async Task ToggleOwned(Paint paint)
    {
        await Manager.SetOwnedAsync(paint, !paint.IsOwned);
    }
}
